# Servidor
PORT=4000

# Base de datos
DATABASE_URL="postgresql://usuario:contraseña@servidor:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:contraseña@servidor:5432/postgres"

# JWT (mínimo 32 caracteres en JWT_SECRET)
JWT_SECRET="cambia-esto-por-un-secreto-largo-de-al-menos-32-chars"
JWT_EXPIRES_IN="24h"

# CORS: lista de orígenes permitidos, separados por coma (sin espacios)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# URL pública de la API (usada en documentación y seeds)
PUBLIC_API_URL="http://localhost:4000"

# Variables opcionales para el seed (credenciales de demostración)
SEED_ADMIN_EMAIL="admin@nextech.com"
SEED_ADMIN_PASSWORD="cambia-esto-antes-de-sembrar"
SEED_USER_EMAIL="estudiante@nextech.com"
SEED_USER_PASSWORD="cambia-esto-antes-de-sembrar"
