{
  "name": "backend-cursos-tecnologicos",
  "version": "1.0.0",
  "description": "API REST Full-Stack para NexTech Academy - Entrega 3 Desarrollo Web",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "start:prod": "prisma migrate deploy && node dist/server.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "clean-architecture",
    "jwt"
  ],
  "author": "Juan Esteban Vallejo",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.9",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "zod": "^3.24.2",
    "prisma": "^6.4.1",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^8.57.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
